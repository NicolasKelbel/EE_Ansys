    ComponentsToShare=[geometryComponent1],
    Position="Below",
    RelativeTo=system3)
meshComponent1 = system4.GetComponent(Name="Mesh")
meshComponent1.Refresh()
mesh2 = system4.GetContainer(ComponentName="Mesh")
mesh2.Edit()
mesh2.Exit()
mesh2.Edit()
mesh2.Exit()
system5 = GetSystem(Name="Geom 11")
geometryComponent2 = system5.GetComponent(Name="Geometry")
system6 = GetSystem(Name="Geom 13")
system7 = template1.CreateSystem(
    ComponentsToShare=[geometryComponent2],
    Position="Below",
    RelativeTo=system6)
meshComponent2 = system7.GetComponent(Name="Mesh")
meshComponent2.Refresh()
mesh3 = system7.GetContainer(ComponentName="Mesh")
mesh3.Edit()
mesh3.Exit()
Save(Overwrite=True)
